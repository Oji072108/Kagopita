PORT=3000
PUBLIC_URL=http://localhost:3000
KAGOPITA_DATA_DIR=./data
# Production: TLS reverse proxy, private app listener, no debug output.
# NODE_ENV=production
# BIND_HOST=127.0.0.1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set both only after verifying the owner's existing account.
KAGOPITA_ADMIN_USER_ID=
KAGOPITA_ADMIN_EMAIL=
KAGOPITA_MONITOR_URL=https://kagopita.com
# Absolute path to private blue/green release configuration, if configured.
KAGOPITA_RELEASE_CONFIG=
